# Base URL of the DocuMind API as seen by the browser.
# Leave unset in development: Vite proxies /api to VITE_DEV_API_TARGET (same-origin cookies).
# VITE_API_BASE_URL=/api

# Backend the Vite dev server proxies /api to.
VITE_DEV_API_TARGET=http://localhost:3000

# Canonical public origin of THIS frontend, used only to build invitation links when the
# backend returns no inviteUrl (its APP_BASE_URL is unset). Bare origin, https in production,
# no path/query/fragment, e.g. https://docs.your-company.example — set at build time.
# Leave unset to rely on the backend's APP_BASE_URL. In the Vite dev server the current
# origin is used as a last resort; production builds never fall back to the current origin.
# VITE_PUBLIC_APP_URL=
