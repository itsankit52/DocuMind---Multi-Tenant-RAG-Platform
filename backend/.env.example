PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=
DATABASE_POOL_MAX=20
PG_TENANT_SETTING=
# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth Secrets (must be at least 32 characters in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=
COOKIE_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173

# MinIO Object Storage
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_CONSOLE_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=
MAX_FILE_SIZE_MB=10

# RabbitMQ
RABBITMQ_URL=amqp
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=
RABBITMQ_RETRY_QUEUE=
RABBITMQ_DLQ=
RABBITMQ_EXCHANGE=

# Document Processing & Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_PROCESSING_ATTEMPTS=3
MAX_EXTRACTED_TEXT_MB=20
MAX_CHUNKS_PER_DOCUMENT=5000

# Qdrant Vector Store
QDRANT_URL=
QDRANT_COLLECTION=
QDRANT_API_KEY=

# Ollama Embeddings & LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=
OLLAMA_LLM_MODEL=
EMBEDDING_DIMENSION=768

# RAG Configuration
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0
RAG_MAX_CONTEXT_CHARS=15000
RAG_MAX_QUESTION_LENGTH=1000

# Conversation / Chat Configuration
# Maximum number of prior messages to include in LLM conversation context
MAX_CONVERSATION_MESSAGES=10
# Maximum characters from conversation history injected into the LLM prompt
MAX_CONVERSATION_CONTEXT_CHARS=4000
# Maximum length of a single user chat message
CHAT_MAX_QUESTION_LENGTH=1000
# Rate limiting for POST /api/conversations/:id/messages and .../messages/stream (shared budget; LLM generation is expensive)
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60000

# SSE Streaming Configuration
# Heartbeat interval (in ms) to keep SSE connection alive through proxies
SSE_HEARTBEAT_INTERVAL_MS=15000
# Maximum timeout for a streaming LLM response (in ms)
CHAT_STREAM_TIMEOUT_MS=120000
# Maximum number of characters accumulated in streamed response before termination
MAX_STREAMED_RESPONSE_CHARS=10000




# Observability (Step 13)
# Expose Prometheus metrics at GET /metrics (API) and on WORKER_METRICS_PORT (worker)
METRICS_ENABLED=
# Optional bearer token for /metrics. Leave empty for local dev: /metrics is then served
# only to loopback / private-network clients (e.g. the Prometheus container).
METRICS_TOKEN=
# debug | info | warn | error | silent   (default: info; silent under NODE_ENV=test)
LOG_LEVEL=info
# json (one JSON object per line) | pretty (human-readable, local dev only)
LOG_FORMAT=json
WORKER_METRICS_PORT=9464
# Per-dependency timeout for GET /health/ready
HEALTH_CHECK_TIMEOUT_MS=2000
# docker-compose host ports (bound to 127.0.0.1) and Grafana login — use your own password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

TRUST_PROXY=
# Max graceful-shutdown time before force exit (keep below Docker stop_grace_period)
SHUTDOWN_TIMEOUT_MS=

