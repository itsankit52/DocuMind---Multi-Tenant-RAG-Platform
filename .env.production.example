PUBLIC_ORIGIN=
# Host port Nginx listens on (80 behind a TLS-terminating LB, or use docker-compose.tls.yml)
NGINX_HTTP_PORT=
# Reverse-proxy hops in front of the API: 1 = Nginx only, 2 = external LB + Nginx
TRUST_PROXY=
# Image tag to run (set to a release tag / git SHA for rollbacks)
IMAGE_TAG=

# PostgreSQL — owner/superuser (migrations + backups only; never used by the app)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Password for documind_runtime, the NOSUPERUSER role the API/worker connect as
DB_RUNTIME_PASSWORD=
DATABASE_POOL_MAX=

# Auth (each >= 32 chars, distinct)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# Redis (rate limiting) — password required
REDIS_PASSWORD=

# RabbitMQ (document processing queue) — do not use guest/guest
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MinIO (document originals; private bucket, internal network only)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=

# Qdrant API key (required; Qdrant is internal-only as well)
QDRANT_API_KEY=

# Ollama models (pulled once into a persistent volume by the ollama-init service)
OLLAMA_EMBEDDING_MODEL=
OLLAMA_LLM_MODEL=
# Optional: reuse an existing Docker volume that already contains the models
# OLLAMA_MODELS_VOLUME=

# Observability (Prometheus/Grafana bind to 127.0.0.1 only)
LOG_LEVEL=
METRICS_TOKEN=
PROMETHEUS_PORT=
PROMETHEUS_RETENTION=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Resource limits (see docs/DEPLOYMENT.md → Resources)
API_CPUS=
API_MEMORY=
WORKER_CPUS=
WORKER_MEMORY=
WORKER_REPLICAS=